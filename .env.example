# Copy to .env.local for local testing (never commit the real .env.local).
# All of these must also be set as encrypted env vars in Vercel for deploys.

CHANNEL=telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-dev-bot-token-from-BotFather
WEBHOOK_SECRET=choose-a-long-random-string
ADMIN_CHAT_IDS=111111111,222222222
MERCHANT_VPA=yourbusiness@upi
STATIC_QR_URL=https://example.com/static-brand-qr.png
REDIS_REST_URL=https://xxxx.upstash.io
REDIS_REST_TOKEN=your-upstash-redis-rest-token
GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
SHEET_ID=your-google-sheet-id-from-the-url
SENTRY_DSN=

# AI mockup generation — see docs/Mockup-Template-Generation.md
# Note: Gemini's free image-generation tier no longer exists as of this
# writing (confirmed via ai.google.dev/gemini-api/docs/pricing). OpenRouter
# (Seedream 4.5, ~$0.04/image) is the tested, working default.
MOCKUP_IMAGE_PROVIDER=openrouter      # "openrouter" (tested) or "gemini" (currently non-functional, kept for future use)
GEMINI_API_KEY=                       # from https://aistudio.google.com/apikey — only if MOCKUP_IMAGE_PROVIDER=gemini
OPENROUTER_API_KEY=                   # from https://openrouter.ai/settings/keys
MOCKUP_IMAGE_MODEL=bytedance-seed/seedream-4.5
