# Copy to .env.local for local testing (never commit the real .env.local).
# All of these must also be set as encrypted env vars in Vercel for deploys.

CHANNEL=whatsapp
META_API_TOKEN=your-meta-api-token
META_PHONE_NUMBER_ID=your-meta-phone-number-id
META_BUSINESS_ACCOUNT_ID=your-meta-business-account-id
META_WEBHOOK_SECRET=choose-a-long-random-string

# Base URL for outbound WhatsApp Cloud API calls. Default is Meta-direct.
# When using a Tech Provider (BSP), point this at their wrapper endpoint.
# Examples:
#   Direct Meta:        https://graph.facebook.com
#   Emovur (BSP):       https://metagraph.backendprod.com
META_API_BASE_URL=https://graph.facebook.com

# Meta App Secret — used to verify the X-Hub-Signature-256 HMAC-SHA256
# signature on inbound webhook POSTs (Meta's standard). When unset, the
# webhook logs a warning and accepts unverified POSTs (insecure).
# Get from Meta App Dashboard -> WhatsApp -> Configuration -> Webhook ->
# "Verify token" field / Meta App -> Settings -> Basic -> App Secret.
META_APP_SECRET=

ADMIN_CHAT_IDS=111111111,222222222
MERCHANT_VPA=yourbusiness@upi
STATIC_QR_URL=https://example.com/static-brand-qr.png
REDIS_REST_URL=https://xxxx.upstash.io
REDIS_REST_TOKEN=your-upstash-redis-rest-token
GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
SHEET_ID=your-google-sheet-id-from-the-url
SENTRY_DSN=

# AI mockup generation — see docs/Mockup-Template-Generation.md
# Note: Gemini's free image-generation tier no longer exists as of this
# writing (confirmed via ai.google.dev/gemini-api/docs/pricing). OpenRouter
# (Seedream 4.5, ~$0.04/image) is the tested, working default.
MOCKUP_IMAGE_PROVIDER=openrouter      # "openrouter" (tested) or "gemini" (currently non-functional, kept for future use)
GEMINI_API_KEY=                       # from https://aistudio.google.com/apikey — only if MOCKUP_IMAGE_PROVIDER=gemini
OPENROUTER_API_KEY=                   # from https://openrouter.ai/settings/keys
MOCKUP_IMAGE_MODEL=bytedance-seed/seedream-4.5

# Standalone mockup-delivery endpoint (api/mockup-delivery.ts) — decoupled
# from the Telegram webhook so AI generation (30-60s+) is never subject to
# grammY's internal webhook timeout. See src/mockup/deliverTrigger.ts.
# This is a SEPARATE trust boundary from the public webhook: a leaked webhook
# secret must NOT also let an attacker trigger paid AI generations. The endpoint
# fail-closes (503) when this is unset — set it to a long random string that is
# NOT the same as META_WEBHOOK_SECRET.
INTERNAL_MOCKUP_SECRET=
PUBLIC_BASE_URL=                      # optional; falls back to Vercel's VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL at runtime

# Durable generated-mockup storage (Vercel Blob) + paid-generation workflow.
# BLOB_READ_WRITE_TOKEN is auto-populated by Vercel once a Blob store is
# linked to the project; set it locally only for `vercel dev`.
# STORAGE IS MANDATORY: if this is unset (or an upload fails), the mockup is
# NOT sent to Telegram — the generation is marked failed and admins are
# notified. A customer must never receive an image that can't be retrieved
# from storage later.
BLOB_READ_WRITE_TOKEN=                # from Vercel dashboard → Storage → Blob → connect
MOCKUP_FREE_PER_MONTH=3               # free generations per chat per Asia/Kolkata calendar month
MOCKUP_PAID_PRICE_INR=20              # ₹ charged per generation once the monthly free quota is used up
