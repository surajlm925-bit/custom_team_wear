{
  "functions": {
    "api/webhook.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "assets/catalog/**"
    },
    "api/mockup-delivery.ts": {
      "memory": 1024,
      "maxDuration": 120
    },
    "api/heartbeat.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/heartbeat",
      "schedule": "0 3 * * *"
    }
  ]
}
